# Copiar a .env (en el VPS: /srv/bouncyblobs/.env, permisos 600). Nunca subir el .env real.

# contraseña de la base del juego (larga y al azar: openssl rand -base64 32)
POSTGRES_PASSWORD=

# Cloudflare Access (protege admin.<dominio>): Zero Trust → Access → Applications → la app del admin
#   CF_ACCESS_TEAM_DOMAIN = <tu-equipo>.cloudflareaccess.com
#   CF_ACCESS_AUD         = "Application Audience (AUD) Tag" de esa app
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# (opcional) además de la regla de Cloudflare, sólo estos emails ven el panel (separados por coma)
ADMIN_EMAILS=

# zona horaria de los reportes
REPORT_TZ=America/Argentina/Buenos_Aires
